# Copy to .env.local for local work, or set these in your host's environment settings.
# NEVER commit real values. Variables starting NEXT_PUBLIC_ are visible to every visitor, so put nothing secret in them.

# --- Required in production ---
# Postgres connection string (Supabase "Transaction pooler" or direct, Neon, Railway, ...). Without it the app refuses to start in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional: connections per server instance (default 5). Use a small number on serverless hosts.
# DATABASE_POOL_MAX=5
# Public address of the site, no trailing slash. Used in links, sitemap and emails. (Read at run time. NEXT_PUBLIC_SITE_URL also works but is fixed at build time.)
SITE_URL=https://www.example.com
# One-time secret (16+ random characters) that allows creating the first owner account at /admin/setup. Remove it afterwards.
ADMIN_SETUP_TOKEN=

# --- Email (optional until you are ready; nothing is sent without both) ---
RESEND_API_KEY=
EMAIL_FROM="Fixit <orders@your-verified-domain.example>"
# 16+ random characters. Lets a scheduler call GET /api/cron/email with "Authorization: Bearer <secret>". Leave empty to disable the endpoint.
CRON_SECRET=

# --- Optional fallbacks (the owner normally sets these in Admin → Store settings) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_MAPS_URL=
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_OPENING_HOURS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Operations ---
# Set to 1 to show a maintenance page to the public (staff can still use /admin).
MAINTENANCE_MODE=

# --- Development and testing ONLY. Never set these in production. ---
# 1 = shows a DEMO banner, blocks search engines, enables the demo seed endpoint.
NEXT_PUBLIC_DEMO_MODE=
# Use "memory://" for a throwaway embedded database; unset to use .data/pglite.
FIXIT_PGLITE_DIR=
# Multiplies rate limits so automated browser tests are not locked out.
RATE_LIMIT_MULTIPLIER=

# --- Online payment gateways (NOT connected; listed so you know what a future integration needs) ---
# JAZZCASH_MERCHANT_ID= JAZZCASH_PASSWORD= JAZZCASH_INTEGRITY_SALT=
# EASYPAISA_STORE_ID= EASYPAISA_HASH_KEY=
# SAFEPAY_API_KEY= SAFEPAY_SECRET_KEY= SAFEPAY_WEBHOOK_SECRET=
